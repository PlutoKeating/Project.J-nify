# J-nify backend — .env.example
# Copy to `.env` and adjust. The backend exposes a single unique port fully
# controlled here, so operators can later mount intranet penetration onto it to
# reach a production URL. Use one-command deployment for the API.

# --- App ---
APP_NAME=J-nify API
APP_ENV=development
APP_VERSION=0.1.0

# --- Unique network port / host (fully controlled via .env) ---
# The ONLY port the backend exposes. Choose a free, unique value per environment.
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Data ---
# SQLite for the MVP scaffold (SPEC: use SQLite). Path is relative to the
# backend working dir. Change `DATABASE_URL` to switch backends later.
DATABASE_URL=sqlite:///./data/jnify.db
SESSION_TTL_SECONDS=3600

# --- Security / privacy ---
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=120

# --- Observability ---
LOG_LEVEL=info

# --- LLM gateway (stub / degradable; leave empty to force template fallback) ---
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=template-fallback

# --- Guardrail defaults ---
QUIET_HOURS_START=23:30
QUIET_HOURS_END=08:30
MAX_NUDGE_BUDGET=3
