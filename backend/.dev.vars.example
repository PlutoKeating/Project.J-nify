# jnify-data 数据服务（本地开发：cd ../data && npm run dev，监听 8789；服务密钥与 data 的 dev 脚本里相同）
JNIFY_DATA_URL=http://127.0.0.1:8789
JNIFY_DATA_KEY=dev-key-dev-key-dev-key-dev-key-0000
# 账号服务（PlutoKeating 账号，OIDC issuer）；缺省就是线上地址
ID_ISSUER=https://id.plutokeating.beer/
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60
QUIET_HOURS_START=23:30
QUIET_HOURS_END=08:30
MAX_NUDGE_BUDGET=3
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
