# J-nify frontend — .env.example
# 后端地址等配置完全由 .env 控制（便于运维与版本控制；.env 本身不入库）。
# 复制为 .env 后按需修改。
# 生产上线环境唯一 Base URL：https://j-nify.williamhvollita.dpdns.org
# （代码默认值即生产地址；本地 Worker 默认由 wrangler 监听 http://localhost:8787）
BACKEND_BASE_URL=http://localhost:8787
APP_ENV=development
API_TIMEOUT=15

# 登录用 PlutoKeating 账号（https://id.plutokeating.beer，client jnify-app），地址固定在 lib/auth/account.dart，不需要配置。

# 天气/地图（本地处理，真值不提交；release 构建用 --dart-define 注入）
OPENWEATHER_API_KEY=
# 天地图 Key 为服务端配置（CF Secret TIANDITU_KEY，经 /v1/geo/reverse 代理），App 不再持有
