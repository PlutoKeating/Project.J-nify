# jnify-data 的配置。./start.sh 第一次运行时复制为 .env（权限 600）并生成密钥；.env 不入库。

# 自动生成：Workers 后端访问这里用的服务密钥（Workers 的 Secret JNIFY_DATA_KEY 要与它相同）。不要泄露；更换后两边同时改。
JNIFY_DATA_KEY=
# 本机端口：只发布到 127.0.0.1，由已有的反向隧道转发（例如 Cloudflare Tunnel 的公共主机名 → http://localhost:8789）
JNIFY_DATA_LOCAL_PORT=8789
# 可选：npm 镜像源（服务器连 npmjs.org 慢时）
NPM_REGISTRY=https://registry.npmjs.org
