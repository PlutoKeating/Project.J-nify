{
  "name": "jnify-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "J-nify 的数据服务：用户数据存在 SQLite，给 Workers 后端提供 Supabase 数据接口写法的一个子集",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "dev": "JNIFY_DATA_DIR=./.dev JNIFY_DATA_KEY=dev-key-dev-key-dev-key-dev-key-0000 JNIFY_DATA_PORT=8789 node --disable-warning=ExperimentalWarning --watch src/main.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
